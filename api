export default async function handler(req, res) {
    if (req.method !== 'POST') {
        return res.status(405).json({ error: 'Method Not Allowed' });
    }

    const { text } = req.body;
    const API_KEY = "AQ.Ab8RN6Jt7Wdnmj9_DRmq5owsJJDM0HGlr0Ks0GFZ_bK5ELVXYg";

    try {
        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                contents: [{ parts: [{ text: text }] }]
            })
        });

        const data = await response.json();

        if (data.candidates && data.candidates[0].content.parts[0].text) {
            return res.status(200).json({ reply: data.candidates[0].content.parts[0].text });
        } else {
            return res.status(400).json({ error: data.error?.message || "لم يتم استلام رد صحيح من النموذج." });
        }
    } catch (error) {
        return res.status(500).json({ error: "حدث خطأ أثناء الاتصال بالخادم." });
    }
}
